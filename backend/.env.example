# ========================
# アプリケーション基本設定
# ========================
APP_NAME=Tomo-sumi
DEBUG=false
# true: Swagger UI有効・SQLログ出力（開発時のみ）

# ========================
# データベース
# ========================
# 形式: postgresql+asyncpg://ユーザー名:パスワード@ホスト:ポート/DB名
DATABASE_URL=postgresql+asyncpg://tomo:tomo@db:5432/tomo_dev

# ========================
# Redis
# ========================
REDIS_URL=redis://redis:6379/0

# ========================
# JWT認証
# ========================
# 最低32文字のランダム文字列（本番は必ず変更する）
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ========================
# CORS
# ========================
# JSON配列形式で指定する（pydantic-settings v2の仕様）
CORS_ORIGINS=["http://localhost:5173"]

# ========================
# Firebase（FCMプッシュ通知）
# ========================
FIREBASE_SERVICE_ACCOUNT_PATH=firebase_service_account.json

# ========================
# メディアファイル
# ========================
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media

# ========================
# Celery（タスクキュー）
# ========================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
